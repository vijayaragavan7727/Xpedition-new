{
  "_metadata": {
    "workflowName": "Educational Illustration",
    "workflowVersion": "1.0.0",
    "targetModel": "v1-5-pruned-emaonly.safetensors",
    "modelFamily": "Stable Diffusion 1.5",
    "modelLicense": "CreativeML Open RAIL-M (Commercial use permitted with standard ethical restrictions)",
    "intendedVisualType": "educational_illustration",
    "defaultResolution": {
      "width": 512,
      "height": 512
    },
    "vramRequirement": "2GB - 4GB (Runs efficiently on CPU mode)",
    "description": "Standard production-ready text-to-image educational diagram and concept visual workflow."
  },
  "nodes": {
    "3": {
      "inputs": {
        "seed": 42,
        "steps": 18,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      },
      "class_type": "KSampler",
      "_meta": {
        "title": "KSampler"
      }
    },
    "4": {
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "Load Checkpoint"
      }
    },
    "5": {
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage",
      "_meta": {
        "title": "Empty Latent Image"
      }
    },
    "6": {
      "inputs": {
        "text": "educational scientific illustration, DC electric motor with rotating armature, copper coil, magnetic poles, clean educational diagram style, high quality",
        "clip": ["4", 1]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "CLIP Text Encode (Prompt)"
      }
    },
    "7": {
      "inputs": {
        "text": "blurry, low quality, dark, messy, deformed, watermark, signature, text artifact, distorted",
        "clip": ["4", 1]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "CLIP Text Encode (Negative Prompt)"
      }
    },
    "8": {
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode"
      }
    },
    "9": {
      "inputs": {
        "filename_prefix": "xpedition_edu",
        "images": ["8", 0]
      },
      "class_type": "SaveImage",
      "_meta": {
        "title": "Save Image"
      }
    }
  }
}
