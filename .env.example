# ==============================================================================
# XPEDITION — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Cloud Persistence)
# ------------------------------------------------------------------------------
# If left empty, Xpedition automatically runs in resilient Local Fallback Mode
# with in-memory / local storage persistence and mock authentication.
#
# Production / Preview / Local:
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ------------------------------------------------------------------------------
# 2. INTELLIGENCE & AI GATEWAY PROVIDERS (Optional Enablers)
# ------------------------------------------------------------------------------
# FreeLLMAPI Gateway (Optional external multi-model router)
FREELLMAPI_URL=
FREELLMAPI_API_KEY=

# Direct AI Providers (Optional — deterministic fallback active if unconfigured)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
TAVILY_API_KEY=

# Feature Gating
PAID_AI_ENABLED=false

# ------------------------------------------------------------------------------
# 3. VISUAL INTELLIGENCE & COMFYUI (Phase D1 Local / Server Infrastructure)
# ------------------------------------------------------------------------------
# ComfyUI base URL for server-side visual generation (NEVER exposed to browser)
COMFYUI_BASE_URL=http://127.0.0.1:8188
# ComfyUI execution timeout in milliseconds (default: 300000ms / 5 minutes)
COMFYUI_TIMEOUT_MS=300000

# ------------------------------------------------------------------------------
# 4. PRODUCTION HARDENING, CACHING, STORAGE & RATE LIMITING (PHASE 5)
# ------------------------------------------------------------------------------
# Distributed Cache Provider: "memory" (default for local) or "redis"
CACHE_PROVIDER=memory
# Redis Connection URL (e.g. redis://default:<password>@<host>:<port> or rediss:// for TLS)
REDIS_URL=

# Asset Storage Provider: "local" (default) or "supabase" or "s3"
STORAGE_PROVIDER=local
# Supabase storage bucket name for educational assets
SUPABASE_STORAGE_BUCKET=educational-assets
# Local asset storage directory (defaults to public/generated-visuals)
LOCAL_ASSET_DIR=public/generated-visuals

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_VISUAL_GEN=10
RATE_LIMIT_CLASSROOM=60
RATE_LIMIT_DEFAULT=120

# Observability & Logging
LOG_LEVEL=info
TRACE_BUFFER_LIMIT=200

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT SPECIFIC GUIDELINES
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# - NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY can be blank
#   to use isolated local persistence, or set to your Supabase dev project.
#
# VERCEL PREVIEW:
# - Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in Vercel
#   Project Settings -> Environment Variables for Preview branches.
#
# VERCEL PRODUCTION:
# - Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in Vercel
#   Project Settings -> Environment Variables for Production.

