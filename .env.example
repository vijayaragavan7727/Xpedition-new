# ==============================================================================
# XPEDITION — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required for Cloud Persistence)
# ------------------------------------------------------------------------------
# If left empty, Xpedition automatically runs in resilient Local Fallback Mode
# with in-memory / local storage persistence and mock authentication.
#
# Production / Preview / Local:
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ------------------------------------------------------------------------------
# 2. INTELLIGENCE & AI GATEWAY PROVIDERS (Optional Enablers)
# ------------------------------------------------------------------------------
# FreeLLMAPI Gateway (Optional external multi-model router)
FREELLMAPI_URL=
FREELLMAPI_API_KEY=

# Direct AI Providers (Optional — deterministic fallback active if unconfigured)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
TAVILY_API_KEY=

# Feature Gating
PAID_AI_ENABLED=false

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT SPECIFIC GUIDELINES
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT:
# - NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY can be blank
#   to use isolated local persistence, or set to your Supabase dev project.
#
# VERCEL PREVIEW:
# - Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in Vercel
#   Project Settings -> Environment Variables for Preview branches.
#
# VERCEL PRODUCTION:
# - Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY in Vercel
#   Project Settings -> Environment Variables for Production.
